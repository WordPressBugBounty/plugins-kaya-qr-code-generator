#: lib/class.forms_qrcode.php:34 lib/class.forms_qrcode.php:43
msgid "Title"
msgstr "Titre"

#: lib/class.forms_qrcode.php:44
msgid "Optional title displayed above the QR code."
msgstr "Titre facultatif affiché au-dessus du QR code."

#: lib/class.forms_qrcode.php:52
msgid "Heading level"
msgstr "Niveau de titre"

#: lib/class.forms_qrcode.php:53
msgid "Choose the heading level for the title. The default is h2."
msgstr "Choisissez le niveau du titre. La valeur par défaut est h2."

#: lib/class.forms_qrcode.php:68
msgid "Title alignment"
msgstr "Alignement du titre"

#: lib/class.forms_qrcode.php:69
msgid "Choose how the title is aligned horizontally."
msgstr "Choisissez l'alignement horizontal du titre."

#: lib/class.forms_qrcode.php:71 lib/class.forms_qrcode.php:200
#: lib/class.forms_qrcode.php:303
msgid "None"
msgstr "Aucun"

#: lib/class.forms_qrcode.php:72 lib/class.forms_qrcode.php:201
#: lib/class.forms_qrcode.php:304
msgid "Left"
msgstr "Gauche"

#: lib/class.forms_qrcode.php:73 lib/class.forms_qrcode.php:202
#: lib/class.forms_qrcode.php:305
msgid "Center"
msgstr "Centre"

#: lib/class.forms_qrcode.php:74 lib/class.forms_qrcode.php:203
#: lib/class.forms_qrcode.php:306
msgid "Right"
msgstr "Droite"

#: lib/class.forms_qrcode.php:84
msgid "Content"
msgstr "Contenu"

#: lib/class.forms_qrcode.php:93
msgid "Content to encode"
msgstr "Contenu à encoder"

#: lib/class.forms_qrcode.php:94
msgid ""
"Enter the text, URL or other content to encode in the QR code. Leave empty "
"to automatically use the current page URL."
msgstr ""
"Saisissez le texte, l'URL ou tout autre contenu à encoder dans le QR code. "
"Laissez le champ vide pour utiliser automatiquement l'URL de la page "
"actuelle."

#: lib/class.forms_qrcode.php:102
msgid "Process dynamic content"
msgstr "Traiter le contenu dynamique"

#: lib/class.forms_qrcode.php:103
msgid ""
"Enable this option to process other shortcodes contained in the QR code "
"content."
msgstr ""
"Activez cette option pour traiter les autres shortcodes dans le contenu du "
"QR code."

#: lib/class.forms_qrcode.php:110
msgid "Query string"
msgstr "Chaîne de requête"

#: lib/class.forms_qrcode.php:111
msgid ""
"Optional query parameters added to the current page URL. Do not include the "
"initial \"?\". This option is only available when the content field is empty."
msgstr ""
"Paramètres de requête facultatifs ajoutés à l'URL de la page actuelle. "
"N'incluez pas le \"?\" initial. Cette option n'est disponible que lorsque le "
"champ de contenu est vide."

#: lib/class.forms_qrcode.php:119
msgid "URL anchor"
msgstr "Ancre d'URL"

#: lib/class.forms_qrcode.php:120
msgid ""
"Optional anchor added to the current page URL. Do not include the initial "
"\"#\". This option is only available when the content field is empty."
msgstr ""
"Ancre facultative ajoutée à l'URL de la page actuelle. N'incluez pas le "
"caractère \"#\" initial. Cette option n'est disponible que lorsque le champ "
"de contenu est vide."

#: lib/class.forms_qrcode.php:130
msgid "QR code image"
msgstr "Image du QR code"

#: lib/class.forms_qrcode.php:139
msgid "Error correction level"
msgstr "Niveau de correction d'erreurs"

#: lib/class.forms_qrcode.php:140
msgid ""
"Determines how much of the QR code can be damaged or obscured while "
"remaining readable."
msgstr ""
"Détermine quelle proportion du QR code peut être endommagée ou masquée tout "
"en restant lisible."

#: lib/class.forms_qrcode.php:142
msgid "Low ~7%"
msgstr "Faible ~7%"

#: lib/class.forms_qrcode.php:143
msgid "Medium ~15%"
msgstr "Moyen ~15%"

#: lib/class.forms_qrcode.php:144
msgid "Quartile ~25%"
msgstr "Quartile ~25 %"

#: lib/class.forms_qrcode.php:145
msgid "High ~30%"
msgstr "Haut ~30%"

#: lib/class.forms_qrcode.php:153
msgid "Size"
msgstr "Taille"

#: lib/class.forms_qrcode.php:154
msgid "Set the QR code size in pixels. Leave empty to use the automatic size."
msgstr ""
"Définissez la taille du QR code en pixels. Laissez vide pour utiliser la "
"taille automatique."

#: lib/class.forms_qrcode.php:161
msgid "Border width"
msgstr "Épaisseur de la bordure"

#: lib/class.forms_qrcode.php:162
msgid "Set the width of the empty margin around the QR code. The default is 4."
msgstr ""
"Définissez la largeur de la marge vide autour du QR code. La valeur par "
"défaut est de 4."

#: lib/class.forms_qrcode.php:181
msgid "QR code color"
msgstr "Couleur du QR code"

#: lib/class.forms_qrcode.php:182
msgid "Choose the color of the QR code. Leave empty to use the default color."
msgstr ""
"Choisissez la couleur du QR code. Laissez vide pour utiliser la couleur par "
"défaut."

#: lib/class.forms_qrcode.php:189
msgid "Background color"
msgstr "Couleur d’arrière-plan"

#: lib/class.forms_qrcode.php:190
msgid ""
"Choose the background color of the QR code. Leave empty to use the default "
"color. Use \"#FFFFFF00\" for a transparent background."
msgstr ""
"Choisissez la couleur d'arrière-plan du QR code. Laissez le champ vide pour "
"utiliser la couleur par défaut. Utilisez \"#FFFFFF00\" pour un arrière-plan "
"transparent."

#: lib/class.forms_qrcode.php:197
msgid "Image alignment"
msgstr "Alignement de l'image"

#: lib/class.forms_qrcode.php:198
