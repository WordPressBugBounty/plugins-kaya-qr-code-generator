msgid "Disable the plugin styles"
msgstr "Désactiver les styles du plugin"

#: lib/class.forms_qrcode.php:220
msgid "Disable the default plugin styles applied to the QR code image."
msgstr ""
"Désactivez les styles du plugin appliqués par défaut à l'image du QR code."

#: lib/class.forms_qrcode.php:227
msgid "Alternative text"
msgstr "Texte alternatif"

#: lib/class.forms_qrcode.php:228
msgid ""
"Optional alternative text for the QR code image. Leave empty to use \"QR "
"Code\"."
msgstr ""
"Texte alternatif facultatif pour l'image du QR code. Laissez vide pour "
"utiliser \"QR Code\"."

#: lib/class.forms_qrcode.php:238
msgid "Clickable link"
msgstr "Lien cliquable"

#: lib/class.forms_qrcode.php:247
msgid "Destination URL"
msgstr "URL de destination"

#: lib/class.forms_qrcode.php:248
msgid "Make the QR code image clickable by entering a destination URL."
msgstr ""
"Rendez l'image du QR code cliquable en saisissant une URL de destination."

#: lib/class.forms_qrcode.php:256
msgid "Open the link in a new tab"
msgstr "Ouvrir le lien dans un nouvel onglet"

#: lib/class.forms_qrcode.php:257
msgid ""
"Open the destination URL in a new browser tab when the QR code image is "
"clicked."
msgstr ""
"Ouvrez l'URL de destination dans un nouvel onglet du navigateur lorsque l'on "
"clique sur l'image du QR code."

#: lib/class.forms_qrcode.php:264
msgid "Use the QR code content as the link"
msgstr "Utilisez le contenu du QR code comme lien"

#: lib/class.forms_qrcode.php:265
msgid ""
"Use the QR code content as the clickable link. This option is only available "
"when no destination URL is specified."
msgstr ""
"Utilisez le contenu du QR code comme lien cliquable. Cette option n'est "
"disponible que lorsqu'aucune URL de destination n'est spécifiée."

#: lib/class.forms_qrcode.php:274
msgid "Download button"
msgstr "Bouton de téléchargement"

#: lib/class.forms_qrcode.php:283
msgid "Add a download button"
msgstr "Ajouter un bouton de téléchargement"

#: lib/class.forms_qrcode.php:284
msgid "Display a button that allows visitors to download the QR code image."
msgstr ""
"Affiche un bouton permettant aux visiteurs de télécharger l'image du QR code."

#: lib/class.forms_qrcode.php:291
msgid "Button text"
msgstr "Texte du bouton"

#: lib/class.forms_qrcode.php:292
msgid ""
"Text displayed on the download button. Leave empty to use \"Download QR "
"code\"."
msgstr ""
"Texte affiché sur le bouton de téléchargement. Laissez vide pour utiliser "
"\"Télécharger le QR code\"."

#: lib/class.forms_qrcode.php:300
msgid "Button alignment"
msgstr "Alignement du bouton"

#: lib/class.forms_qrcode.php:301
msgid "Choose how the download button is aligned horizontally."
msgstr "Choisissez l'alignement horizontal du bouton de téléchargement."

