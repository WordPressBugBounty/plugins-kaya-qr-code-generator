msgid "Add a shadow to the QR code"
msgstr "Ajouter une ombre au QR code"

#: lib/class.forms_qrcode.php:212
msgid "Add a visual shadow around the QR code image."
msgstr "Ajoutez une ombre visuelle autour de l'image du QR code."

